<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ローカル フィード（.nupkg/。 リポジトリへはコミットしない）を最優先の取得元にする。
       未公開の版を利用側のアプリとパッケージング検証で試すときに使う
       （同名・同バージョンのパッケージが nuget.org に存在すると、意図しないものを拾うため先に解決させる）。
       規則は .github/ビルド設定規約.md §4。 -->
  <packageSources>
    <clear />
    <add key="local" value=".nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
