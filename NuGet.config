<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 取得元は nuget.org だけを明示する。 マシン／ユーザー単位の取得元はここで消さない
       （`<clear />` を書くと、下で案内する「ローカル フィードの追加」も効かなくなる）。
       ローカル フィード（.nupkg/。 リポジトリへはコミットしない）は**登録しない**。
       存在しないフォルダーを取得元に書くと、クローン直後と CI の復元が NU1301 で失敗する（実測）。

       未公開の版を試すときは、その環境でだけ取得元へ追加する（リポジトリの設定は変えない）。
       追加は `dotnet nuget add source <.nupkg のパス>` で行う（取得元の名前は任意）。

       手順は .github/開発手順.md §3、規則は .github/ビルド設定規約.md §4。 -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- パッケージ ソースのマッピング（中央パッケージ管理を使うときは必須。 無いと NU1507 で失敗する）。
       **すべてのパッケージを nuget.org から取る**と宣言する。 マシン／ユーザー単位で追加した取得元
       （ローカル フィード等）は、ここに pattern を足さない限り復元に使われない。
       未公開の版を試すときは、検証スクリプト（buildScript/verifyPackaging.ps1）と同じく
       **その場限りの NuGet.config** を作り、`<packageSourceMapping>` も併せて書く。
       規則は .github/ビルド設定規約.md §4。 -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
