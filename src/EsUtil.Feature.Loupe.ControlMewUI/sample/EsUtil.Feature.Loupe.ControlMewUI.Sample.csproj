<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.Feature.Loupe.MewUI.Sample</RootNamespace>
    <!-- MewUI は API が安定化中（0.x）。 破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32 プラットフォームホスト + Windows 向け描画バックエンド -->
    <PackageReference Include="Aprillz.MewUI.Windows" Version="$(MewUIVersion)" />
    <!-- SkiaCanvasView（コントロールが使う描画キャンバス） -->
    <PackageReference Include="Aprillz.MewUI.Skia" Version="$(MewUIVersion)" />
    <!-- Direct2D ⇔ Skia の GPU ブリッジ（未登録でも CPU 経路で動作するが、描画コストが高い） -->
    <PackageReference Include="Aprillz.MewUI.Skia.Interop.Direct2D" Version="$(MewUIVersion)" />
    <!-- 操作ログ（コントロールの Log へ設定する） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- サンプルの対象（コア・提示層は推移参照で解決する） -->
    <ProjectReference Include="..\src\MewUI\EsUtil.Feature.Loupe.ControlMewUI.csproj" />
  </ItemGroup>

</Project>
