    <InternalsVisibleTo Include="EsUtil.Feature.Marquee.ControlAvaloniaUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- コア（選択幾何・状態機械）とコントロール化の転送規則・描画手順。 コアは提示層の公開面に現れるため推移参照で解決する -->
    <ProjectReference Include="..\..\..\EsUtil.Feature.Marquee.Presenter\src\EsUtil.Feature.Marquee.Presenter.csproj" />
  </ItemGroup>

</Project>
