<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.Ui.AvaloniaUI.StyledText</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>書式付き文字列（run 単位の書式）を表示・編集する Avalonia UI 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil\Feature.StyledText.Core\src\EsUtil.Feature.StyledText.Core.csproj" />
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 色からブラシへの変換は同一 UI の変換ブリッジが単一所有する（写しを持つとキャッシュが二重になる） -->
    <ProjectReference Include="..\..\Interop\src\EsUtil.Ui.AvaloniaUI.Interop.csproj" />
    <!-- 書式バーの色の選択は UI の色選択コントロールを使う（色名・16 進・ピッカーの解釈を 1 つに集約する） -->
    <ProjectReference Include="..\..\ColorSelector\src\EsUtil.Ui.AvaloniaUI.ColorSelector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.AvaloniaUI.StyledText.Tests" />
    <!-- 注釈は本文の描画と実寸を本アセンブリの RichTextPainter へ委ねる（写しを持つと見た目が食い違う） -->
    <InternalsVisibleTo Include="EsUtil.Ui.AvaloniaUI.Annotation" />
    <InternalsVisibleTo Include="EsUtil.Ui.AvaloniaUI.Annotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.StyledText" />
    <Using Include="EsUtil.Feature.StyledText.Core.Text" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Drawing" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Editing" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Formatting" />
  </ItemGroup>

</Project>
