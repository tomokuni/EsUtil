<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Ui.AvaloniaUI.Loupe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する。 実測 2026-10-23: 警告 0）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>ルーペの Avalonia UI 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- コア（LoupeOptions / 幾何）と描画手順。 コアは提示層の公開面に現れるため推移参照で解決する -->
    <ProjectReference Include="..\..\..\EsUtil\Feature.Loupe.Presenter\src\EsUtil.Feature.Loupe.Presenter.csproj" />
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <ProjectReference Include="..\..\Interop\src\EsUtil.Ui.AvaloniaUI.Interop.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.AvaloniaUI.Loupe.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 機能のルート名前空間（ファサードの公開面）を取り込む。 -->
    <Using Include="EsUtil.Feature.Loupe" />
  </ItemGroup>

</Project>
