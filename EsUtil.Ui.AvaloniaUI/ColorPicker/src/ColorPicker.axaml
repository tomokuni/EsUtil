<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EsUtil.Ui.AvaloniaUI.ColorPicker"
             x:Class="EsUtil.Ui.AvaloniaUI.ColorPicker.ColorPickerControl"
             x:Name="PART_Root"
             x:DataType="local:ColorPickerControl"
             x:CompileBindings="True">
    <UserControl.Resources>
        <local:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <local:ColorDisplayConverter x:Key="ColorDisplayConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- バリデーションエラー時の枠線強調（フォーカス・ホバー状態でもテーマスタイルに優先する） -->
        <Style Selector="ComboBox.validation-error /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Red"/>
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
        <!-- ComboBox はデフォルトテーマを維持 -->
        <Grid>
            <ComboBox x:Name="_comboBox"
                      Text="{Binding SelectedColor, ElementName=PART_Root, Converter={StaticResource ColorDisplayConverter}, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      MinWidth="{Binding ComboBoxMinWidth, ElementName=PART_Root}"
                      MaxWidth="{Binding ComboBoxMaxWidth, ElementName=PART_Root}"
                      Width="{Binding ComboBoxWidth, ElementName=PART_Root}"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnSelectionChanged"
                      LostFocus="OnLostFocus"
                      ToolTip.Tip="色名または16進カラーコードを入力、または▼から選択">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ColorEntry">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="14" Height="14" CornerRadius="2"
                                    BorderBrush="Gray" BorderThickness="1"
                                    Background="{Binding Value, Converter={StaticResource StringToBrushConverter}}"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- 色スウォッチ（ComboBox のテキスト領域左端にオーバーレイ） -->
            <Border Width="16" Height="16"
                    CornerRadius="2"
                    BorderBrush="Gray" BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    IsHitTestVisible="False"
                    Margin="10,0,0,0"
                    Background="{Binding SelectedColor, ElementName=PART_Root, Converter={StaticResource StringToBrushConverter}}"/>
        </Grid>
        <Button Grid.Column="1" Content="…" MinWidth="24" MinHeight="22"
                Click="OnColorPickerButtonClick"
                ToolTip.Tip="色選択ダイアログ"/>
    </Grid>
</UserControl>

