<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.Ui.AvaloniaUI.Annotation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>注釈（枠線・吹き出し・テキスト）の Avalonia UI 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ログの定義（LoggerMessage ソース生成）と、呼び出し側の IsEnabled 判定 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil\Feature.Annotation.Core\src\EsUtil.Feature.Annotation.Core.csproj" />
    <!-- 選択枠とハンドルは Marquee の提示層を再利用する（枠の見た目を 4 つの UI 版で揃えるため） -->
    <ProjectReference Include="..\..\..\EsUtil\Feature.Marquee.Core\src\EsUtil.Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 色からブラシへの変換は同一 UI の変換ブリッジが単一所有する（写しを持つとキャッシュが二重になる） -->
    <ProjectReference Include="..\..\Interop\src\EsUtil.Ui.AvaloniaUI.Interop.csproj" />
    <!-- 本文の表示と編集は書式付き文字列の編集コントロールを使う（4 つの UI 版で同じ振る舞いにする） -->
    <ProjectReference Include="..\..\StyledText\src\EsUtil.Ui.AvaloniaUI.StyledText.csproj" />
    <!-- 色の選択は UI の色選択コントロールを使う（色名・16 進・ピッカーの解釈を 1 つに集約する） -->
    <ProjectReference Include="..\..\ColorSelector\src\EsUtil.Ui.AvaloniaUI.ColorSelector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.AvaloniaUI.Annotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.Annotation" />
  </ItemGroup>
</Project>