<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cp="clr-namespace:EsUtil.Ui.AvaloniaUI.ColorComboBox;assembly=EsUtil.Ui.AvaloniaUI.ColorComboBox"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900"
        x:Class="EsUtil.Ui.AvaloniaUI.ColorComboBox.Sample.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:vm="clr-namespace:EsUtil.Ui.AvaloniaUI.ColorComboBox.Sample.ViewModels"
        Title="ColorComboBoxControl サンプル"
        Width="450" Height="780">
    <Window.Resources>
        <cp:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </Window.Resources>

    <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="ColorComboBoxControl サンプル"
                   FontSize="20" FontWeight="Bold"/>

        <TextBlock Text="選択した色"
                   FontWeight="SemiBold"/>

        <!-- 選択色プレビュー -->
        <Border Height="60" CornerRadius="4"
                BorderBrush="Gray" BorderThickness="1"
                Background="{Binding SelectedColor, Converter={StaticResource StringToBrushConverter}}"/>

        <!-- 色選択コントロール（色相順・枠線強調あり） -->
        <StackPanel Spacing="4">
            <TextBlock Text="色相順（ByHue）" FontWeight="SemiBold"/>
            <cp:ColorComboBoxControl x:Name="MainPicker"
                                   SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                                   ColorSortMode="{Binding ColorSortMode, Mode=TwoWay}"
                                   HighlightBorderOnError="{Binding HighlightBorderOnError, Mode=TwoWay}"
                                   Width="300" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 色選択コントロール（色名順） -->
        <StackPanel Spacing="4">
            <TextBlock Text="色名順（ByName）" FontWeight="SemiBold"/>
            <cp:ColorComboBoxControl SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                                   ColorSortMode="ByName"
                                   HighlightBorderOnError="{Binding HighlightBorderOnError, Mode=TwoWay}"
                                   Width="300" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 入力欄のレイアウト設定（MinWidth / MaxWidth / Width / Padding / Margin を外部制御） -->
        <StackPanel Spacing="4">
            <TextBlock Text="入力欄のレイアウト設定（MinWidth / Padding / Margin）" FontWeight="SemiBold"/>
            <cp:ColorComboBoxControl SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                                   ColorSortMode="{Binding ColorSortMode, Mode=TwoWay}"
                                   TextFormat="{Binding TextFormat, Mode=TwoWay}"
                                   HighlightBorderOnError="{Binding HighlightBorderOnError, Mode=TwoWay}"
                                   TextMinWidth="{Binding TextMinWidth, Mode=TwoWay}"
                                   TextMaxWidth="{Binding TextMaxWidth, Mode=TwoWay}"
                                   TextWidth="{Binding TextWidth, Mode=TwoWay}"
                                   TextPadding="4,0"
                                   TextMargin="0,0"
                                   Width="300" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- バリデーション状態の表示（メインの ColorComboBoxControl から読み取り） -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock Text="バリデーション状態（メインの ColorComboBoxControl）" FontWeight="SemiBold"/>
                <TextBlock>
                    <Run Text="HasValidationError: "/>
                    <Run Text="{Binding HasValidationError, ElementName=MainPicker}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="ValidationErrorMessage: "/>
                    <Run Text="{Binding ValidationErrorMessage, ElementName=MainPicker}"/>
                </TextBlock>
                <TextBlock Text="※ 無効な色（例: 'zzz'）を入力してフォーカスを外すと最終有効値に復帰します。"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 設定パネル -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="設定" FontWeight="SemiBold"/>
                <CheckBox IsChecked="{Binding HighlightBorderOnError, Mode=TwoWay}"
                          Content="バリデーション失敗時に枠線を赤くする"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="並び順:" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding SortModeIndex, Mode=TwoWay}" Width="200">
                        <ComboBoxItem Content="色相順（ByHue）"/>
                        <ComboBoxItem Content="色名順（ByName）"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="表記:" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding TextFormatIndex, Mode=TwoWay}" Width="200">
                        <ComboBoxItem Content="色名 + 不透明度"/>
                        <ComboBoxItem Content="#AARRGGBB"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="TextMinWidth:" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding TextMinWidth, Mode=TwoWay}"
                                   Minimum="80" Maximum="400" Increment="10"
                                   Width="120"/>
                </StackPanel>
                <TextBlock Text="現在の値（SelectedColor）:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SelectedColor, Mode=OneWay}" IsReadOnly="True"/>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Window>
