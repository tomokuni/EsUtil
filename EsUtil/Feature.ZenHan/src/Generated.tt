void RenderEntryLevel(EntryContext ctx, IEnumerable<EntryRecord> entries) {
    var cls = ctx.GetClassContext();
    var children = ctx.GetChildren(entries);
    bool hasChildren = children.Count > 0;
    if ((ctx.Prefix == "GroupOf" || ctx.Prefix == "NameOf") && ctx.IsLeaf ) {
        return; // 末端レベルは処理しない
    }
#>
    /// <summary><#= cls.smy #></summary>  <remarks><#= cls.rmk #></remarks>
    public record <#= cls.cls #><#= string.IsNullOrEmpty(cls.iface) ? "" : " : " + cls.iface #> {
        /// <summary><#= cls.smy #></summary>  <remarks><#= cls.rmk #></remarks>
        public static <#= cls.cls #> Instance { get; } = new();

<#
    foreach (var cnv in ctx.GetToXxContext(entries)) {
#>
        /// <summary><#= cnv.smy #></summary>  <remarks><#= cnv.rmk #></remarks>
        public ConvertPairs <#= cnv.cvt #>Map { get; } = ConvertPairs.From<#= cnv.type #>($"<#= cnv.cnvCtx.MainKey #>");
<#
    }

    if (hasChildren) {
#>

<#
        foreach (var group in children) {
            var childCtx = ctx.NextShortcut(group.Key!, group);
            var childCls = childCtx.GetClassContext();
#>
        /// <summary><#= childCls.smy #></summary>  <remarks><#= childCls.rmk #></remarks>
        public <#= childCls.cls #> <#= group.Key #> { get; } = <#= childCls.cls #>.Instance;
<#
        }
    }
#>
    }
<#
