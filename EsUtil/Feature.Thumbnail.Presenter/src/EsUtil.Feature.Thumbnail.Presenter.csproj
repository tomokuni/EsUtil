<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Feature.Thumbnail</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する。 実測 2026-10-23: 警告 0）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>サムネイルの外観・影・描画計画・ラベル計画を単一所有する UI 非依存の提示層。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本層は「描画計画（影・枠・ラベル）」と「外観」を単一所有する。 描画 API は抽象化しない
         （UI フレームワークごとの描画モデルの差を吸収しきれないため、描画は各 UI が行う）。 -->
    <ProjectReference Include="..\..\Feature.Thumbnail.Core\src\EsUtil.Feature.Thumbnail.Core.csproj" />
    <ProjectReference Include="..\..\Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本層が単一所有する設定（計算に必要な設定・外観）の変更ログ（LoggerMessage ソース生成）を持つ -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Feature.Thumbnail.Presenter.Tests" />
  </ItemGroup>

</Project>
