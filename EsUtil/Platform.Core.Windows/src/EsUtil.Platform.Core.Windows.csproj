<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.Platform.Core.Windows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- System.Drawing.Bitmap のピクセルへ直接アクセスするため unsafe を許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- このライブラリは Windows 専用だが、Native AOT の解析（トリム/AOT 警告）は有効にする。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>System.Drawing.Bitmap と EsUtil.Platform.Core の画像型を相互変換する Windows 専用の拡張。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows 専用の画像型（System.Drawing.Bitmap）との相互変換を行う。 Windows でのみ動作する -->
    <PackageReference Include="System.Drawing.Common" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EsUtil.Platform.Core" Version="$(EsUtil_Platform_Core_Version)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Platform.Core.Windows.Tests" />
  </ItemGroup>

</Project>
