<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Feature.Thumbnail</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する。 実測 2026-10-23: 警告 0）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>サムネイル一覧（折り返し配置・選択・可視範囲）の UI 非依存の計算層。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EsUtil.Platform.Core" Version="$(EsUtil_Platform_Core_Version)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 選択（コアが単一所有する状態）の変更ログ定義（LoggerMessage ソース生成）を持つ。
         EsUtil.Platform.Core 経由の推移参照でも解決できるが、本コアが直接使う依存のため明示する。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部手順（配置の計算）は単体テストにのみ公開する。 -->
    <InternalsVisibleTo Include="EsUtil.Feature.Thumbnail.Core.Tests" />
  </ItemGroup>

</Project>
