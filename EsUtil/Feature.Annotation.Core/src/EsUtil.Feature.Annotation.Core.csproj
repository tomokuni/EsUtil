<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.Feature.Annotation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>注釈（枠線・吹き出し・テキスト）の UI 非依存の計算層と提示層（外観・描画計画）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 本文の書式・折り返し・行対応は再利用可能な文字の計算層（EsUtil.Feature.StyledText.Core）が単一所有する -->
    <ProjectReference Include="..\..\Feature.StyledText.Core\src\EsUtil.Feature.StyledText.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 読み込み・保存・設定の変更のログ定義（LoggerMessage ソース生成）を本コアが所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部手順（折り返し・JSON 変換）は単体テストからのみ参照する -->
    <InternalsVisibleTo Include="EsUtil.Feature.Annotation.Core.Tests" />
  </ItemGroup>
</Project>