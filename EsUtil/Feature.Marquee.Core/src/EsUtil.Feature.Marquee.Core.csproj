<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Feature.Marquee</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する。 実測 2026-10-23: 警告 0）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>マーキー選択（ドラッグ矩形の選択・移動・リサイズ）の UI 非依存の計算層。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 入力の判断と描画状態変更のログ定義（LoggerMessage ソース生成）をコアが所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部契約（状態機械・描画入力・幾何計算）はコアの単体テストからのみ参照する。
         UI 実装とホストが使う公開面（設定・通知・フレーム・描画計算）は public のため IVT 不要。 -->
    <InternalsVisibleTo Include="EsUtil.Feature.Marquee.Core.Tests" />
  </ItemGroup>

</Project>
