<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Platform.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- EsBitmap がピクセルバッファへ直接アクセスするため unsafe を許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32 の生成対象のアーキテクチャ。 SetWindowLongPtrW / GetWindowLongPtrW はメタデータ上
         「特定の CPU アーキテクチャでのみ利用可能」とされており、AnyCPU では生成されない（実測: PInvoke005）。
         本ライブラリの配布物は win-x64 のみであり、x64 として生成する。
         生成されるのは user32 の P/Invoke 宣言だけであり、公開面は変わらない。 -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>UI フレームワーク非依存の共通基盤（キーと入力・幾何・座標変換・画像・OS サービス抽象）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 外部パッケージを参照しない（MEL / System.Drawing を使わない）
         ログは呼び出し側が所有し、OS 操作の失敗は例外または bool の戻り値で表す。
         **例外はソース生成だけを目的とするパッケージ**である（実行時依存を持たない。 規則は
         .github/命名規約.md §ルート名前空間）。 Win32 の宣言は CsWin32 が生成する。 -->
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Platform.Core.Tests" />
  </ItemGroup>

</Project>
