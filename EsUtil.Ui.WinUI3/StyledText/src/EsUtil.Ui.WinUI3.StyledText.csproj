<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>EsUtil.Ui.WinUI3.StyledText</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- このライブラリは Windows 専用だが、Native AOT の解析（トリム/AOT 警告）は有効にする。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>書式付き文字列（run 単位の書式）を表示・編集する WinUI 3 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil\Feature.StyledText.Core\src\EsUtil.Feature.StyledText.Core.csproj" />
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 色からブラシへの変換は同一 UI の変換ブリッジが単一所有する（写しを持つとキャッシュが二重になる） -->
    <ProjectReference Include="..\..\Interop\src\EsUtil.Ui.WinUI3.Interop.csproj" />
    <!-- 書式バーの色の選択は UI の色選択コントロールを使う -->
    <ProjectReference Include="..\..\ColorSelector\src\EsUtil.Ui.WinUI3.ColorSelector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.StyledText.Tests" />
    <!-- 注釈は本文の描画と実寸を本アセンブリの RichTextMetrics へ委ねる（写しを持つと見た目が食い違う） -->
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.Annotation" />
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.Annotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.StyledText" />
    <Using Include="EsUtil.Feature.StyledText.Core.Text" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Drawing" />
    <Using Include="EsUtil.Feature.StyledText.Core.Editing" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Formatting" />
  </ItemGroup>

</Project>