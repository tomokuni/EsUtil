<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>EsUtil.Ui.WinUI3.Interop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NativeAOT のソース生成 P/Invoke（Bootstrapper）で unsafe を使う -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- このライブラリは Windows 専用だが、Native AOT の解析（トリム/AOT 警告）は有効にする。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Bootstrapper へ渡す版（majorMinor・版タグ・最小版）は、参照している Microsoft.WindowsAppSDK の
         パッケージが生成する定数から取る（ライブラリ側に版を書かない。 値の所有者は Directory.Packages.props）。 -->
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <Description>WinUI 3 と EsUtil の型（キー・幾何・色・ウィンドウ状態・画像）を相互変換するブリッジ。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3（Microsoft.UI.Xaml）のコントロールと、WinRT の投影型（Windows.Foundation の幾何型・色型） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.Interop.Tests" />
  </ItemGroup>

</Project>