<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.Ui.WinUI3.ColumnPacking</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinUI の型（UIElement）を WinRT ABI へ渡すため、CsWinRT の生成コードが unsafe を要する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT 互換を宣言する（トリム/AOT の警告をビルドで検出する）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>縦方向のマルチカラム配置を行う WinUI 3 のパネル（最大列高さを最小化するレイアウト計算は EsUtil.Feature.ColumnPacking が単一所有する）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EsUtil.Feature.ColumnPacking" Version="$(EsUtil_Feature_ColumnPacking_Version)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.ColumnPacking.Tests" />
  </ItemGroup>

</Project>
