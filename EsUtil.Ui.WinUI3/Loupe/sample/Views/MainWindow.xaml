<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EsUtil.Ui.WinUI3.Loupe.Sample.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loupe="using:EsUtil.Ui.WinUI3.Loupe"
    xmlns:views="using:EsUtil.Ui.WinUI3.Loupe.Sample.Views"
    Title="LoupeControl サンプル（WinUI 3）">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 設定パネル -->
        <ScrollViewer Grid.Column="0" Padding="12">
            <StackPanel Spacing="12">
                <TextBlock Text="表示" FontWeight="SemiBold" />
                <CheckBox x:Name="ShowLoupeCheck" Content="ルーペを表示" IsChecked="True" />
                <TextBlock Text="拡大率" />
                <Slider x:Name="ZoomSlider" Minimum="1" Maximum="16" Value="4" StepFrequency="1" />
                <TextBlock Text="ルーペ サイズ" />
                <Slider x:Name="SizeSlider" Minimum="80" Maximum="480" Value="240" StepFrequency="10" />
                <TextBlock Text="描画スケール" />
                <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Value="1.0" StepFrequency="0.1" />

                <TextBlock Text="外観" FontWeight="SemiBold" />
                <TextBlock Text="十字線の色" />
                <ComboBox x:Name="CrosshairColorBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="画像外（ペーストボード）の色" />
                <ComboBox x:Name="PasteboardColorBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="枠線の色" />
                <ComboBox x:Name="BorderColorBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="枠線の太さ" />
                <Slider x:Name="BorderThicknessSlider" Minimum="0" Maximum="8" Value="1" StepFrequency="1" />
                <CheckBox x:Name="ShowLabelCheck" Content="座標ラベルを表示" IsChecked="True" />

                <TextBlock Text="操作" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RequestRenderButton" Content="再描画を要求" />
                    <Button x:Name="HideAndReleaseButton" Content="非表示にして解放" />
                    <Button x:Name="ResetSourceButton" Content="ソースを再設定" />
                </StackPanel>

                <TextBlock Text="選択矩形（破線オーバーレイ）" FontWeight="SemiBold" />
                <CheckBox x:Name="ShowSelectionCheck" Content="選択矩形を表示" IsChecked="True" />
                <TextBlock Text="X" />
                <NumberBox x:Name="SelectionXBox" Minimum="0" Maximum="800" Value="250" SpinButtonPlacementMode="Compact" />
                <TextBlock Text="Y" />
                <NumberBox x:Name="SelectionYBox" Minimum="0" Maximum="600" Value="180" SpinButtonPlacementMode="Compact" />
                <TextBlock Text="W" />
                <NumberBox x:Name="SelectionWidthBox" Minimum="0" Maximum="800" Value="300" SpinButtonPlacementMode="Compact" />
                <TextBlock Text="H" />
                <NumberBox x:Name="SelectionHeightBox" Minimum="0" Maximum="600" Value="200" SpinButtonPlacementMode="Compact" />

                <TextBlock Text="拡張例（見本）" FontWeight="SemiBold" />
                <CheckBox x:Name="ShowPreviewCheck" Content="格子線と四隅の鉤を描く見本を表示" IsChecked="True" />

                <TextBlock Text="ログ" FontWeight="SemiBold" />
                <Border BorderBrush="#FF808080" BorderThickness="1" Height="180">
                    <ScrollViewer>
                        <TextBlock x:Name="LogText" FontSize="11" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- テスト画像とルーペを重ねる領域 -->
        <ScrollViewer
            Grid.Column="1"
            Padding="12"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="HostCanvas" Width="800" Height="600" Background="#FF202020">
                <views:SourceCanvas x:Name="SourceCanvas" Width="800" Height="600" />
                <TextBlock x:Name="SelectionLabel" FontSize="11" Foreground="#FFFF8C00" Visibility="Collapsed" />
                <loupe:LoupeControl x:Name="Loupe" />
                <loupe:LoupeControl x:Name="Preview" />
            </Canvas>
        </ScrollViewer>
    </Grid>
</Window>
