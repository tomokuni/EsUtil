<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.Ui.WinUI3.Thumbnail</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- このライブラリは Windows 専用だが、Native AOT の解析（トリム/AOT 警告）は有効にする。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>サムネイル一覧の WinUI 3 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EsUtil.Feature.Thumbnail.Presenter" Version="$(EsUtil_Feature_Thumbnail_Presenter_Version)" />
    <PackageReference Include="EsUtil.Platform.Core" Version="$(EsUtil_Platform_Core_Version)" />
    <PackageReference Include="EsUtil.Ui.WinUI3.Interop" Version="$(EsUtil_Ui_WinUI3_Interop_Version)" />
    <!-- 本コントロールが単一所有する値（画像・項目数）の変更ログ（LoggerMessage ソース生成）を持つ -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.Thumbnail.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 機能のルート名前空間（ファサードの公開面）を取り込む。 -->
    <Using Include="EsUtil.Feature.Thumbnail" />
  </ItemGroup>

</Project>
