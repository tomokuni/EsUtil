<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EsUtil.Ui.WinUI3.Thumbnail.Sample.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:thumbnail="using:EsUtil.Ui.WinUI3.Thumbnail"
    Title="ThumbnailControl サンプル（WinUI 3）">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="サムネイルを選択してください。" />
            <Button x:Name="AddButton" Content="追加" />
            <Button x:Name="ScrollButton" Content="末尾へスクロール" />
            <CheckBox x:Name="DarkThemeCheck" Content="暗色テーマ" />
        </StackPanel>

        <thumbnail:ThumbnailControl x:Name="Thumbnails" Grid.Row="1" />
    </Grid>
</Window>