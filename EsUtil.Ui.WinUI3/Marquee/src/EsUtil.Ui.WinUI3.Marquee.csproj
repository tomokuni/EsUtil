<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.Ui.WinUI3.Marquee</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>マーキーの WinUI 3 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="[3.*,4.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EsUtil.Feature.Marquee.Presenter" Version="$(EsUtil_Feature_Marquee_Presenter_Version)" />
    <PackageReference Include="EsUtil.Platform.Core" Version="$(EsUtil_Platform_Core_Version)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EsUtil.Ui.WinUI3.Marquee.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 名前空間が EsUtil.Ui.<UI>.<機能> へ分かれたため、機能のルート名前空間（ファサードの公開面）を
         グローバル using で取り込む（以前は名前空間の入れ子で解決していた）。 -->
    <Using Include="EsUtil.Feature.Marquee" />
  </ItemGroup>

</Project>
