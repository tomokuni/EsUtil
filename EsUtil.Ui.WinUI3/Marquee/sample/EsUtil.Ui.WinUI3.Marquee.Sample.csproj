<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.Ui.WinUI3.Marquee.Sample</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- アンパッケージ（MSIX を使わない）で実行するため、パッケージ化せず Windows App SDK を同封する -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 自己完結の配置は対象アーキテクチャを要する（既定を x64 とし、`-r` で上書きできるようにする） -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- DPI 認識と対応 OS の宣言（アンパッケージで実行するために必要） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
    <!-- 背景のテスト パターンを描く SKXamlCanvas（コントロールと同じ描画基盤） -->
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="[3.*,4.0.0)" />
    <!-- 操作ログ（コントロールの Log へ設定する） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- サンプルの対象（コア・提示層は推移参照で解決する） -->
    <ProjectReference Include="..\src\EsUtil.Ui.WinUI3.Marquee.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 名前空間が EsUtil.Ui.<UI>.<機能> へ分かれたため、機能のルート名前空間（ファサードの公開面）を
         グローバル using で取り込む（以前は名前空間の入れ子で解決していた）。 -->
    <Using Include="EsUtil.Feature.Marquee" />
  </ItemGroup>

</Project>
