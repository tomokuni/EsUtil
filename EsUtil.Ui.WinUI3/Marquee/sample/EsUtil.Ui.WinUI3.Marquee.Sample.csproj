<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.Ui.WinUI3.Marquee.Sample</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- アンパッケージ（MSIX を使わない）で実行するため、パッケージ化せず Windows App SDK を同封する -->
    <!-- EnableMsixTooling は付けない。 付けると publish は自身の .pri を発行するが、
         ソリューションのビルド順によっては参照側の .pri が未生成のまま PRI252 で失敗する（実測 2026-10-26）。
         サンプルは配布しないため、通常のビルドが出力する .pri で足りる。
         配布するときは publish へ -p:EnableMsixTooling=true を渡す。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Windows App SDK の自己完結配置はアーキテクチャの指定を要求する
         （実測: 未指定は `WindowsAppSDKSelfContained requires a supported Windows architecture.` で失敗する）。
         既定は x64。 `-r`（グローバル プロパティ）で上書きできる。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- DPI 認識と対応 OS の宣言（アンパッケージで実行するために必要） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- 背景のテスト パターンを描く SKXamlCanvas（コントロールと同じ描画基盤） -->
    <!-- 操作ログ（コントロールの Log へ設定する） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- サンプルの対象（コア・提示層は推移参照で解決する） -->
    <ProjectReference Include="..\src\EsUtil.Ui.WinUI3.Marquee.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 機能のルート名前空間（ファサードの公開面）を取り込む。 -->
    <Using Include="EsUtil.Feature.Marquee" />
  </ItemGroup>

</Project>
