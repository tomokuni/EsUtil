<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EsUtil.Ui.WinUI3.Marquee.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:marquee="using:EsUtil.Ui.WinUI3.Marquee"
    xmlns:views="using:EsUtil.Ui.WinUI3.Marquee.Sample.Views"
    Title="EsUtil.Ui.WinUI3.Marquee サンプル">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- 操作（結線はすべてコードビハインドで行う。 XAML 属性では結線しない） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="8">
            <ComboBox x:Name="ScaleSelector" Header="表示倍率" MinWidth="120" />
            <CheckBox x:Name="GuideSelector" Content="見本（破線・ガイド線）" VerticalAlignment="Bottom" />
            <Button x:Name="ClearButton" Content="クリア" VerticalAlignment="Bottom" />
            <Button x:Name="ConfirmButton" Content="確定" VerticalAlignment="Bottom" />
            <Button x:Name="CancelButton" Content="キャンセル" VerticalAlignment="Bottom" />
        </StackPanel>

        <!-- 選択の対象（背景のテスト パターン）と選択オーバーレイ（重ね順は背景 → オーバーレイ → 目印） -->
        <Grid Grid.Row="1" Margin="8" Background="#FF202020" MinHeight="240">
            <views:TestPatternCanvas x:Name="Background" />
            <marquee:MarqueeControl x:Name="Marquee" />
            <Canvas IsHitTestVisible="False">
                <Ellipse
                    x:Name="LoupeMarker"
                    Width="24"
                    Height="24"
                    Stroke="#FFFFC400"
                    StrokeThickness="2"
                    Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <!-- 操作ログ（コントロール内部のログとサンプルのイベント ログを同じ表示へ流す） -->
        <ListView
            Grid.Row="2"
            x:Name="LogList"
            Margin="8"
            FontFamily="Consolas"
            FontSize="12"
            SelectionMode="None" />
    </Grid>
</Window>
