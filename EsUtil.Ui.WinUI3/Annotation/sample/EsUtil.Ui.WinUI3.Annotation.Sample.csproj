<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>EsUtil.Ui.WinUI3.Annotation.Sample</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- アンパッケージ（MSIX なし）で起動できるようにする。 規則は .github/ビルド設定規約.md §5。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 自己完結配置は RID を要求する（publish の -r を渡したときだけ有効にする） -->
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <Description>注釈の WinUI 3 版コントロールの動作確認用サンプル アプリケーション。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\EsUtil.Ui.WinUI3.Annotation.csproj" />
    <!-- サンプル共通のレイアウトとログ（Serilog） -->
    <ProjectReference Include="..\..\SampleKit\src\EsUtil.Ui.WinUI3.SampleKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.Annotation" />
  </ItemGroup>

</Project>