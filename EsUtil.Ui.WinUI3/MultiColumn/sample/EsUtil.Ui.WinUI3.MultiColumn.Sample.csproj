<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.Ui.WinUI3.MultiColumn.Sample</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- アンパッケージ（MSIX を使わない）で実行するため、パッケージ化せず Windows App SDK を同封する -->
    <!-- publish のときだけ必要な指定（ビルドとテストには影響しない）。
         これを付けないと publish が自分自身の .pri（リソース インデックス）を発行せず、
         配布物の起動時に XAML の読み込みが失敗して 0xC000027B（stowed exception）で終了する（実測 2026-10-24）。 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 自己完結の配置は対象アーキテクチャを要する（既定を x64 とし、`-r` で上書きできるようにする） -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- DPI 認識と対応 OS の宣言（アンパッケージで実行するために必要） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- サンプルの対象（依存するレイアウト計算は推移参照で解決する） -->
    <ProjectReference Include="..\src\EsUtil.Ui.WinUI3.MultiColumn.csproj" />
  </ItemGroup>

</Project>
