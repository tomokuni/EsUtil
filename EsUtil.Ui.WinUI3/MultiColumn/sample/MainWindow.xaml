<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EsUtil.Ui.WinUI3.MultiColumn.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EsUtil.Ui.WinUI3.MultiColumn.Sample"
    Title="EsUtil.Ui.WinUI3.MultiColumn サンプル">

    <Grid Padding="12" RowSpacing="8">
        <Grid.Resources>
            <!-- ItemsSource から作る項目の見た目（高さは項目ごとに指定する） -->
            <DataTemplate x:Key="ItemTemplate" x:DataType="local:SampleItem">
                <Border Background="#FFE8F0FE" BorderBrush="#FF1E88E5" BorderThickness="1" CornerRadius="4"
                        Height="{x:Bind Height, Mode=OneTime}">
                    <TextBlock Text="{x:Bind Label}" Margin="8,4" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <Slider Header="列の上限" Minimum="1" Maximum="8" StepFrequency="1" Width="160"
                    Value="{x:Bind ColumnLimit, Mode=TwoWay}" />
            <Slider Header="行間" Minimum="0" Maximum="24" StepFrequency="1" Width="140"
                    Value="{x:Bind RowSpace, Mode=TwoWay}" />
            <Slider Header="列間" Minimum="0" Maximum="24" StepFrequency="1" Width="140"
                    Value="{x:Bind ColumnSpace, Mode=TwoWay}" />
            <Slider Header="アイテム数" Minimum="1" Maximum="60" StepFrequency="1" Width="180"
                    Value="{x:Bind ItemCount, Mode=TwoWay}" />
            <ToggleSwitch Header="ItemsSource を先に置く" IsOn="{x:Bind ItemsSourceFirst, Mode=TwoWay}" />
            <ToggleSwitch Header="デバッグ表示" IsOn="{x:Bind Panel.ShowDebugText, Mode=TwoWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <local:MultiColumnPanelDebugText x:Name="Panel"
                    ColumnLimit="{x:Bind ColumnLimit, Mode=OneWay}"
                    RowSpace="{x:Bind RowSpace, Mode=OneWay}"
                    ColumnSpace="{x:Bind ColumnSpace, Mode=OneWay}"
                    ItemsSourceFirst="{x:Bind ItemsSourceFirst, Mode=OneWay}"
                    ItemsSource="{x:Bind Items, Mode=OneWay}"
                    ItemTemplate="{StaticResource ItemTemplate}">
                <!-- ItemsSource と直接の子の両方を並べられる（順序は ItemsSourceFirst で決まる） -->
                <Border Background="#FFFFF3E0" BorderBrush="#FFFB8C00" BorderThickness="1" CornerRadius="4" Height="56">
                    <TextBlock Text="直接の子 A" Margin="8,4" VerticalAlignment="Center" />
                </Border>
                <Border Background="#FFFFF3E0" BorderBrush="#FFFB8C00" BorderThickness="1" CornerRadius="4" Height="72">
                    <TextBlock Text="直接の子 B" Margin="8,4" VerticalAlignment="Center" />
                </Border>
            </local:MultiColumnPanelDebugText>
        </ScrollViewer>
    </Grid>
</Window>