<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.Ui.MewUI.Annotation.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- テストが使うバックエンドのバージョン（本体と同じ値に固定する） -->
    <MewUIVersion>0.22.1</MewUIVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 画素を読み戻せる GDI バックエンド（合成画像の検証に使う） -->
    <PackageReference Include="Aprillz.MewUI.Backend.Gdi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\EsUtil.Ui.MewUI.Annotation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.Annotation" />
  </ItemGroup>
</Project>