<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Ui.MewUI.Loupe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- MewUI は API が安定化中（0.x）。破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
    <Description>ルーペの MewUI 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- コアの EsBitmap をフレームワーク標準の描画（IGraphicsContext）で描く -->
    <!-- 設定変更・描画例外のログ（LoggerMessage ソース生成・NullLogger。Avalonia 版と同一の書式） -->
    <!-- MewUI のコア（型・標準描画の IGraphicsContext）。 描画はフレームワーク標準を使う -->
    <PackageReference Include="Aprillz.MewUI.Core" Version="$(MewUIVersion)" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- コア（LoupeOptions / 幾何）と描画手順。 コアは提示層の公開面に現れるため推移参照で解決する -->
    <PackageReference Include="EsUtil.Feature.Loupe.Presenter" Version="$(EsUtil_Feature_Loupe_Presenter_Version)" />
    <PackageReference Include="EsUtil.Platform.Core" Version="$(EsUtil_Platform_Core_Version)" />
    <PackageReference Include="EsUtil.Ui.MewUI.Interop" Version="$(EsUtil_Ui_MewUI_Interop_Version)" />
  </ItemGroup>


  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.MewUI.Loupe.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 名前空間が EsUtil.Ui.<UI>.<機能> へ分かれたため、機能のルート名前空間（ファサードの公開面）を
         グローバル using で取り込む（以前は名前空間の入れ子で解決していた）。 -->
    <Using Include="EsUtil.Feature.Loupe" />
  </ItemGroup>

</Project>
