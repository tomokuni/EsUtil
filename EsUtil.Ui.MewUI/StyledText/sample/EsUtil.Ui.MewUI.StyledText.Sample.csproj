<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.Ui.MewUI.StyledText.Sample</RootNamespace>
    <!-- MewUI は API が安定化中（0.x）。 破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.22.1</MewUIVersion>
    <Description>書式付き文字列の編集（MewUI 版コントロール）の動作確認用サンプル アプリケーション。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32 プラットフォームホスト + Windows 向け描画バックエンド -->
    <PackageReference Include="Aprillz.MewUI.Windows" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- サンプルの対象（書式付き文字列の計算は推移参照で解決する） -->
    <ProjectReference Include="..\src\EsUtil.Ui.MewUI.StyledText.csproj" />
    <!-- サンプル共通のレイアウトとログ（Serilog） -->
    <ProjectReference Include="..\..\SampleKit\src\EsUtil.Ui.MewUI.SampleKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.StyledText" />
    <Using Include="EsUtil.Feature.StyledText.Core.Defaults" />
  </ItemGroup>

</Project>