<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.Ui.MewUI.SampleKit</RootNamespace>
    <!-- サンプルの共通部品（レイアウト・ログ）。 `*.SampleKit` は配布しない（ビルド設定規約 §4）。 -->
    <Description>サンプル アプリ共通のレイアウトとログ（Serilog）を提供する（配布しない）。</Description>
  <SupportedOSPlatformVersion>10.0.15063.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

</Project>
