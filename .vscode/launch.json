{
    // サンプル アプリ（各 UI 層の `sample/`）の起動構成。 18 件を UI 層ごとに並べる。
    // **デバッグ実行**で起動する（`noDebug: false`。 ブレークポイント・ステップ実行が効く）。
    // 種別は coreclr を使う（`dotnet` は不可）。 `dotnet` は読み込み済みソリューションのプロジェクトしか
    // 解決できず、`dotnet.defaultSolution` は共通基盤だけの EsUtil.slnx を指すため、UI 層のサンプルは
    // "Unable to determine debug settings for project ..." で起動できない（実測 2026-10-30）。
    // program には apphost（.exe）を指す。 WinUI 3 は .dll を直接起動すると manifest が無く
    // 0xC000027B で終了する（実測）。 TFM は各 csproj の TargetFramework に追随させる。
    // preLaunchTask は**サンプル 1 つ分のプロジェクト**だけを増分ビルドする（ソリューション全体を
    // 毎回評価すると 4 秒前後かかる。 プロジェクト 1 つなら 2 秒弱。 実測 2026-10-31）。
    // 出力は `logging.moduleLoad: false` と `justMyCode: false` で抑える（最適化されたモジュールの
    // シンボル読み込みの案内は問題のない情報のため）。
    // 根拠は .github/検証手順.md §14。
    "version": "0.2.0",
    "configurations": [
        // AvaloniaUI
        {
            "name": "AvaloniaUI / ColorSelector",
            "type": "coreclr",
            "request": "launch",
            "noDebug": false,
            "justMyCode": false,
            "logging": { "moduleLoad": false },
            "preLaunchTask": "ビルド（AvaloniaUI / ColorSelector）",
            "program": "${workspaceFolder}/EsUtil.Ui.AvaloniaUI/ColorSelector/sample/bin/Debug/net10.0/EsUtil.Ui.AvaloniaUI.ColorSelector.Sample.exe",
            "cwd": "${workspaceFolder}/EsUtil.Ui.AvaloniaUI/ColorSelector/sample"
