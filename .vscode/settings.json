{
    // markdownlint 拡張機能（DavidAnson.vscode-markdownlint）は、構成ファイルを**ワークスペースのルート**でのみ
    // 自動探索する。 本リポジトリは構成を buildScript/ へ置く（ルート直下のファイルを減らすため。
    // .github/ビルド設定規約.md §1）ため、場所を明示する。 ${workspaceFolder} は文書ごとのフォルダーへ解決される
    // （複数ルートのワークスペースでも各リポジトリの構成を指す）。
    "markdownlint.configFile": "${workspaceFolder}/buildScript/markdownlint.json"
}
