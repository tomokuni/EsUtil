{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "検証（全体）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "検証（全体・全プロジェクトを作り直す）",
      "detail": "コミット前の最終確認。 増分ビルドでは隠れることがある警告を全件出す（既定は増分）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -FullBuild",
      "problemMatcher": []
    },
    {
      "label": "検証（全体・自動修正）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -Fix",
      "problemMatcher": []
    },
    {
      "label": "検証（ビルド省略）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -SkipBuild -SkipPackage",
      "problemMatcher": []
    },
    {
      "label": "検証（パッケージ省略）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -SkipPackage",
      "problemMatcher": []
    },
    {
      "label": "検証（テスト省略）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -SkipTests",
      "problemMatcher": []
    },
    {
      "label": "検証（情報レベルの検出）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verifyInfoStyle.ps1",
      "problemMatcher": []
    },
    {
      "label": "検証（情報レベルの修正）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verifyInfoStyle.ps1 -Fix",
      "problemMatcher": []
    },
    {
      "label": "パッケージ作成（ローカル フィード）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/pack.ps1",
      "problemMatcher": []
    },
    {
      "label": "ビルド（AvaloniaUI の UI 層）",
      "detail": "サンプルの起動構成（launch.json）の preLaunchTask。 Debug で作り直す",
      "type": "shell",
      "command": "dotnet build EsUtil.Ui.AvaloniaUI/EsUtil.Ui.AvaloniaUI.slnx",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（MewUI の UI 層）",
      "detail": "サンプルの起動構成（launch.json）の preLaunchTask。 Debug で作り直す",
      "type": "shell",
      "command": "dotnet build EsUtil.Ui.MewUI/EsUtil.Ui.MewUI.slnx",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（WinUI3 の UI 層）",
      "detail": "サンプルの起動構成（launch.json）の preLaunchTask。 Debug で作り直す",
      "type": "shell",
      "command": "dotnet build EsUtil.Ui.WinUI3/EsUtil.Ui.WinUI3.slnx",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（WinForms の UI 層）",
      "detail": "サンプルの起動構成（launch.json）の preLaunchTask。 Debug で作り直す",
      "type": "shell",
      "command": "dotnet build EsUtil.Ui.WinForms/EsUtil.Ui.WinForms.slnx",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "テスト実行（全プロジェクト）",
      "type": "shell",
      "command": "dotnet test EsUtil/EsUtil.slnx",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "テスト実行（フィルタ指定）",
      "type": "shell",
      "command": "dotnet test EsUtil/EsUtil.slnx --filter ${input:testFilter}",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "テスト フィルタ（例: FullyQualifiedName~LoupeControlTests）",
      "default": "FullyQualifiedName~LoupeControlTests"
    }
  ]
}
