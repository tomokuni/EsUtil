<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EsUtil.Ui.WinForms.StyledText</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>書式付き文字列（run 単位の書式）を表示・編集する WinForms 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil\Feature.StyledText.Core\src\EsUtil.Feature.StyledText.Core.csproj" />
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- IME（imm32）の P/Invoke と構造体は Interop が単一所有する -->
    <ProjectReference Include="..\..\Interop\src\EsUtil.Ui.WinForms.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.WinForms.StyledText.Tests" />
    <!-- 注釈は本文の描画を本アセンブリの RichTextPainter へ委ねる（写しを持つと見た目が食い違う） -->
    <InternalsVisibleTo Include="EsUtil.Ui.WinForms.Annotation" />
    <InternalsVisibleTo Include="EsUtil.Ui.WinForms.Annotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.StyledText" />
    <Using Include="EsUtil.Feature.StyledText.Core.Text" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Drawing" />
    <Using Include="EsUtil.Feature.StyledText.Core.Editing" />
    <Using Include="EsUtil.Feature.StyledText.Presenter.Formatting" />
  </ItemGroup>

</Project>
