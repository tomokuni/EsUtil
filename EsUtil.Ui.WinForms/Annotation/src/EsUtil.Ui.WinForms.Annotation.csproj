<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EsUtil.Ui.WinForms.Annotation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>注釈（枠線・吹き出し・テキスト）の WinForms 版コントロール。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ログの出力先（ILogger）を公開する（定義はコアが持つ） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EsUtil\Feature.Annotation.Core\src\EsUtil.Feature.Annotation.Core.csproj" />
    <!-- 選択枠とハンドルは Marquee の提示層を再利用する（枠の見た目を 4 つの UI 版で揃えるため） -->
    <ProjectReference Include="..\..\..\EsUtil\Feature.Marquee.Core\src\EsUtil.Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\..\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 本文の表示と編集は書式付き文字列の編集コントロールを使う（4 つの UI 版で同じ振る舞いにする） -->
    <ProjectReference Include="..\..\RichTextEditor\src\EsUtil.Ui.WinForms.RichTextEditor.csproj" />
    <!-- コア型 ⇔ GDI+ 型・画像の変換 -->
    <ProjectReference Include="..\..\Interop\src\EsUtil.Ui.WinForms.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="EsUtil.Ui.WinForms.Annotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.Annotation" />
  </ItemGroup>
</Project>