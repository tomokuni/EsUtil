<Project>

  <PropertyGroup>
    <!-- ライブラリのバージョン。 本体プロジェクトごとに異なるため、**値を持つのは本表だけ**（各 .csproj では指定しない）。
         3 桁目（一番右）だけを buildScript/pack.ps1 が自動で +1 する（ソースの指紋が変わったプロジェクトのみ）。
         1・2 桁目は人が上げる（3 桁目は 0 に戻す）。 規則は .github/ビルド設定規約.md §4。

         MSBuild のプロパティ名にドットは使えない（実測: <EsUtil.Platform.Core.Version> は MSB5016 で失敗する）。
         そのため名前は「パッケージ ID のドットを `_` に置換 + `_Version`」にする（参照側はこの名前を使う）。 -->
    <EsUtil_Platform_Core_Version>0.2.1</EsUtil_Platform_Core_Version>
    <EsUtil_Platform_Core_Windows_Version>0.1.1</EsUtil_Platform_Core_Windows_Version>
    <EsUtil_Feature_Loupe_Core_Version>0.1.1</EsUtil_Feature_Loupe_Core_Version>
    <EsUtil_Feature_Loupe_Presenter_Version>0.1.1</EsUtil_Feature_Loupe_Presenter_Version>
    <EsUtil_Ui_AvaloniaUI_Loupe_Version>0.1.4</EsUtil_Ui_AvaloniaUI_Loupe_Version>
    <EsUtil_Ui_MewUI_Loupe_Version>0.1.2</EsUtil_Ui_MewUI_Loupe_Version>
    <EsUtil_Ui_WinUI3_Loupe_Version>0.1.3</EsUtil_Ui_WinUI3_Loupe_Version>
    <EsUtil_Ui_WinForms_Loupe_Version>0.1.1</EsUtil_Ui_WinForms_Loupe_Version>
    <EsUtil_Feature_Marquee_Core_Version>0.1.1</EsUtil_Feature_Marquee_Core_Version>
    <EsUtil_Feature_Thumbnail_Core_Version>0.1.2</EsUtil_Feature_Thumbnail_Core_Version>
    <EsUtil_Feature_Thumbnail_Presenter_Version>0.1.7</EsUtil_Feature_Thumbnail_Presenter_Version>
    <EsUtil_Ui_AvaloniaUI_Thumbnail_Version>0.1.8</EsUtil_Ui_AvaloniaUI_Thumbnail_Version>
    <EsUtil_Ui_MewUI_Thumbnail_Version>0.1.6</EsUtil_Ui_MewUI_Thumbnail_Version>
    <EsUtil_Ui_WinUI3_Thumbnail_Version>0.1.8</EsUtil_Ui_WinUI3_Thumbnail_Version>
    <EsUtil_Ui_WinForms_Thumbnail_Version>0.1.6</EsUtil_Ui_WinForms_Thumbnail_Version>
    <EsUtil_Feature_Marquee_Presenter_Version>0.1.1</EsUtil_Feature_Marquee_Presenter_Version>
    <EsUtil_Ui_AvaloniaUI_Marquee_Version>0.1.1</EsUtil_Ui_AvaloniaUI_Marquee_Version>
    <EsUtil_Ui_MewUI_Marquee_Version>0.1.2</EsUtil_Ui_MewUI_Marquee_Version>
    <EsUtil_Ui_WinUI3_Marquee_Version>0.1.2</EsUtil_Ui_WinUI3_Marquee_Version>
    <EsUtil_Ui_WinForms_Marquee_Version>0.1.2</EsUtil_Ui_WinForms_Marquee_Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 自分の版は本表から引く（数値を 2 箇所へ書かない）。
         テスト・サンプルは表に行を持たない（パッケージを作らないため SDK 既定のまま）。
         表に行が無い本体プロジェクトは buildScript/verify.ps1 が不合格にする（表の行の欠落・綴り違いを検出する）。 -->
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Platform.Core'">$(EsUtil_Platform_Core_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Platform.Core.Windows'">$(EsUtil_Platform_Core_Windows_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Feature.Loupe.Core'">$(EsUtil_Feature_Loupe_Core_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Feature.Loupe.Presenter'">$(EsUtil_Feature_Loupe_Presenter_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.AvaloniaUI.Loupe'">$(EsUtil_Ui_AvaloniaUI_Loupe_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.MewUI.Loupe'">$(EsUtil_Ui_MewUI_Loupe_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.WinUI3.Loupe'">$(EsUtil_Ui_WinUI3_Loupe_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.WinForms.Loupe'">$(EsUtil_Ui_WinForms_Loupe_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Feature.Marquee.Core'">$(EsUtil_Feature_Marquee_Core_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Feature.Thumbnail.Core'">$(EsUtil_Feature_Thumbnail_Core_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Feature.Thumbnail.Presenter'">$(EsUtil_Feature_Thumbnail_Presenter_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.AvaloniaUI.Thumbnail'">$(EsUtil_Ui_AvaloniaUI_Thumbnail_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.MewUI.Thumbnail'">$(EsUtil_Ui_MewUI_Thumbnail_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.WinUI3.Thumbnail'">$(EsUtil_Ui_WinUI3_Thumbnail_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.WinForms.Thumbnail'">$(EsUtil_Ui_WinForms_Thumbnail_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Feature.Marquee.Presenter'">$(EsUtil_Feature_Marquee_Presenter_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.AvaloniaUI.Marquee'">$(EsUtil_Ui_AvaloniaUI_Marquee_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.MewUI.Marquee'">$(EsUtil_Ui_MewUI_Marquee_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.WinUI3.Marquee'">$(EsUtil_Ui_WinUI3_Marquee_Version)</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'EsUtil.Ui.WinForms.Marquee'">$(EsUtil_Ui_WinForms_Marquee_Version)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- パッケージ出力（全プロジェクト共通。 各 .csproj では指定しない）。
         本体プロジェクトはパッケージを作り、テスト・サンプルは作らない。
         `PackageId` と `AssemblyName` は省略し、プロジェクト名と一致させる。 -->
    <_SeIsTestOrSample>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '\.(Tests|Sample)$'))</_SeIsTestOrSample>
    <IsPackable Condition="'$(_SeIsTestOrSample)' == 'true'">false</IsPackable>
    <IsPackable Condition="'$(_SeIsTestOrSample)' != 'true'">true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- パッケージの基本情報（全プロジェクト共通。 各 .csproj では指定しない）。 -->
    <Authors>EsUtil</Authors>
    <Company>EsUtil</Company>
    <Product>EsUtil</Product>
    <PackageProjectUrl>https://github.com/EsUtil</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- パッケージの説明は各 .csproj の Description が持つ（プロジェクトごとに異なる）。 -->
    <!-- パッケージには XML ドキュメントを含めない（本リポジトリは検証にだけ使い、配布物へは出さない）。 -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- ローカル フィードはプロジェクトごとの 1 ファイルであるため、依存パッケージを同封しない。 -->
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <!-- コード スタイルとドキュメントコメントの検証（全プロジェクト共通。 各 .csproj では指定しない）。
         目的は「機械的に判定できる規約をビルドの警告にする」こと（0 件が合否。 .github/検証手順.md）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- ドキュメント コメントの検証（不足・cref の誤り）を行う。
         本リポジトリはライブラリであり、生成した XML は**パッケージ同封のドキュメント**として
         利用側の IntelliSense に使われるため、出力（lib/<tfm>/<name>.xml）へ含める（既定のまま）。
         そのため `CopyDocumentationFileToOutputDirectory` を false にしない
         （false にするとパッケージ作成が NU5026 で失敗する。 実測）。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- アナライザーの解析モード（全プロジェクト共通。 各 .csproj では指定しない）。
         `Recommended` は SDK が推奨する規則をまとめて有効にする（規則の列挙を .editorconfig へ手書きしない）。
         無効にする規則だけを .editorconfig に `severity = none` で明示する（opt-out 方式）。 -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- 警告をエラーにする（「dotnet build が通れば規約に準拠している」を終了コードで判定できる）。
         検証スクリプトの `-warnaserror` に依存しない（素の `dotnet build` でも検出できる）。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 使用を禁止する API（buildScript/BannedSymbols.txt）をコンパイラで検出する。
         規則の所有者は .github/コーディング規約.md（例: フラグ enum は HasFlag ではなくビット演算を使う）。
         一覧をルート直下に置かないのは、ルートのファイルを減らすため（規則は .github/ビルド設定規約.md §1）。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="[5.*,)" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)buildScript\BannedSymbols.txt" />

    <!-- 規約のうち、SDK のアナライザー（AnalysisMode=Recommended）が検出しない項目を補うアナライザー。
         有効にする規則は .editorconfig が単一所有する（既定の重要度のまま使わない）。 -->
    <!-- 非同期の書き方（`async void` の禁止・`Async` 接尾辞）。 規則は .github/コーディング規約.md §7 / .github/命名規約.md。 -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="[17.*,)" PrivateAssets="all" />
    <!-- ファイル名と型名の一致（MA0048）/ 名前空間セグメントと型名の一致の禁止（MA0049）。
         規則は .github/命名規約.md（「1 ファイル 1 型」「ファイル名は型名と一致」「名前空間セグメントと型名を一致させない」）。 -->
    <PackageReference Include="Meziantou.Analyzer" Version="[3.*,)" PrivateAssets="all" />
  </ItemGroup>

</Project>
